# Copy to `.env.deploy` (gitignored) and fill in.
# CONFIG ONLY — never put passwords here. Auth is via SSH key.

# ── Server identity ─────────────────────────────────────────────────
DEPLOY_HOST=103.212.121.117
DEPLOY_PORT=22999            # MilesWeb cPanel runs sshd on 22999, not 22
DEPLOY_USER=fiwbmawm
DEPLOY_PATH=/home/fiwbmawm/DigiProper
DEPLOY_BASE_BRANCH=main

# ── Paths on the server ─────────────────────────────────────────────
# composer.lock was generated under PHP 8.4, so use ea-php84.
REMOTE_PHP=/opt/cpanel/ea-php84/root/usr/bin/php
REMOTE_COMPOSER=/usr/local/bin/composer

# Set to 1 to drop the site into maintenance mode during deploy
# (artisan down before composer/migrate, artisan up after caches).
# Useful once there are real users; for now leave at 0.
ENABLE_MAINTENANCE_MODE=0

# ─────────────────────────────────────────────────────────────────────
# ONE-TIME SSH KEY SETUP (already done for the current user, kept
# here for future setup):
#
#   1. Reuse or generate ~/.ssh/id_ed25519
#        cat ~/.ssh/id_ed25519.pub
#   2. cPanel → SSH Access → Manage SSH Keys → Import Key → paste pubkey → Authorize
#   3. Test:  ssh -p 22999 fiwbmawm@103.212.121.117 'echo OK'
# ─────────────────────────────────────────────────────────────────────
