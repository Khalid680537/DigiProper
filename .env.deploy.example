# Copy to `.env.deploy` (gitignored) and fill in.
# CONFIG ONLY — never put passwords here. Auth is via cPanel API token (or SSH key, future).

# ── Server identity ─────────────────────────────────────────────────
DEPLOY_HOST=103.212.121.117
DEPLOY_USER=fiwbmawm
DEPLOY_PATH=/home/fiwbmawm/DigiProper
DEPLOY_BASE_BRANCH=main

# ── cPanel (current deploy mechanism — Git Version Control + .cpanel.yml) ──
CPANEL_HOST=utopia.herosite.pro
CPANEL_PORT=2083
CPANEL_USER=fiwbmawm

# Optional: paste a cPanel API token here to fully automate the deploy.
# Without this token, deploy-to-live.sh stops after the local PR merge and
# prints a cPanel link for you to click "Update from Remote" + "Deploy HEAD" manually.
#
# To create one:
#   cPanel → Security → "Manage API Tokens" → "Create"
#   Name: digiproper-deploy
#   No expiry (or set a long one)
#   Copy the token value (shown ONCE) and paste below.
#
# CPANEL_API_TOKEN=

# ── Server PHP/composer (used by .cpanel.yml, not by this script directly) ──
# Reference only; the actual values live in .cpanel.yml on the server side.
REMOTE_PHP=/opt/cpanel/ea-php84/root/usr/bin/php
REMOTE_COMPOSER=/usr/local/bin/composer

ENABLE_MAINTENANCE_MODE=0

# ─────────────────────────────────────────────────────────────────────
# Path A (future): if MilesWeb opens up external SSH for this account,
# we can switch back to direct SSH deploys. SSH key is already authorized in
# cPanel; the limiter is firewall, not auth.
# ─────────────────────────────────────────────────────────────────────
