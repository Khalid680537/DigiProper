# Copy this file to `.env.deploy` (gitignored) and fill in real values.
# This file holds CONFIG ONLY — never passwords. Auth is via SSH key.

# Production server
DEPLOY_HOST=your.server.ip.or.host
DEPLOY_USER=your_ssh_user

# Absolute path to the Laravel app on the server (the dir containing artisan, composer.json, .env)
# On cPanel shared hosting this is usually something like /home/USERNAME/digiproper
DEPLOY_PATH=/home/your_ssh_user/digiproper

# Branch deployed to production
DEPLOY_BASE_BRANCH=main

# Path / alias for PHP & composer on the server.
# Many cPanel hosts ship multiple PHP versions — point to the right one.
# Examples:
#   REMOTE_PHP=/usr/local/bin/php83
#   REMOTE_PHP=/opt/cpanel/ea-php83/root/usr/bin/php
REMOTE_PHP=php
REMOTE_COMPOSER=composer

# Set to 1 to put the site in maintenance mode during deploy (artisan down/up).
# Set to 0 for low-traffic sites where a 1-2s blip is fine.
ENABLE_MAINTENANCE_MODE=0

# ─────────────────────────────────────────────────────────────────────
# ONE-TIME SSH KEY SETUP (do this BEFORE first deploy):
#
#   1. Generate a key on your Mac (skip if you already have ~/.ssh/id_ed25519):
#        ssh-keygen -t ed25519 -C "deploy-digiproper"
#
#   2. Print the public key:
#        cat ~/.ssh/id_ed25519.pub
#
#   3. Add it to the server. Either:
#      a) cPanel UI → "SSH Access" → "Manage SSH Keys" → "Import Key" → paste public key → "Authorize"
#      b) OR over SSH (one-time, with password):
#           ssh-copy-id your_ssh_user@your.server.ip
#
#   4. Test passwordless login:
#        ssh your_ssh_user@your.server.ip 'echo OK'
#      (You should see "OK" without being asked for a password.)
#
#   5. Once it works, change the SSH password (or disable password auth in cPanel
#      if available) so the leaked password from chat is no longer usable.
# ─────────────────────────────────────────────────────────────────────
